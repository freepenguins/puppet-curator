{
  "name": "freepenguins-curator",
  "version": "4.0.0",
  "author": "freepenguins",
  "summary": "Installs Elasticsearch Curator in a Python virtualenv and manages its configuration, actions and schedule",
  "license": "Apache-2.0",
  "source": "https://github.com/freepenguins/puppet-curator",
  "project_page": "https://github.com/freepenguins/puppet-curator",
  "issues_url": "https://github.com/freepenguins/puppet-curator/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 7.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "curator",
    "elasticsearch",
    "elastic",
    "indices",
    "snapshots",
    "retention"
  ],
  "pdk-version": "3.4.0",
  "template-url": "https://github.com/puppetlabs/pdk-templates#3.8.0",
  "template-ref": "tags/3.8.0-0-gf1124a6"
}
